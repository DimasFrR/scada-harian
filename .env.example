# Salin ke .env.local (lokal) atau atur di Vercel > Settings > Environment Variables.
# JANGAN commit file .env berisi nilai asli.

# Password login dashboard (dipakai bersama semua petugas). WAJIB diisi di production.
APP_PASSWORD=

# URL Postgres (otomatis terisi saat Vercel Postgres dihubungkan ke project).
DATABASE_URL=

# Foto bukti pengukuran (Vercel Blob). Kalau kosong, fitur foto nonaktif dan
# pengukuran tetap bisa disimpan tanpa foto. Cara aktifkan: Vercel Dashboard >
# Storage > Create Blob Store, lalu salin tokennya ke sini (Production).
BLOB_READ_WRITE_TOKEN=

# Alarm WhatsApp via Fonnte (https://fonnte.com). Kalau salah satu kosong,
# alarm WA tidak dikirim (alarm tetap tampil di dashboard).
# FONNTE_TOKEN: token dari dashboard Fonnte (Device > token).
FONNTE_TOKEN=
# WA_ALARM_TARGETS: nomor penerima dipisah koma, format 62... (boleh 08...,
# otomatis diubah ke 62...). Contoh: 6281234567890,6289876543210
WA_ALARM_TARGETS=
